{
  "info": {
    "name": "ShopEasy API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"newuser@example.com\",\n  \"password\": \"123456\"\n}" },
            "url": "{{baseUrl}}/api/auth/register"
          }
        },
        {
          "name": "Login (saves token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set('token', j.token); }"
                ]
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"admin@shopeasy.com\",\n  \"password\": \"Admin@123\"\n}" },
            "url": "{{baseUrl}}/api/auth/login"
          }
        },
        {
          "name": "Get Me",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/auth/me" }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Admin\"\n}" },
            "url": "{{baseUrl}}/api/auth/me"
          }
        }
      ]
    },
    {
      "name": "Products and Categories",
      "item": [
        {
          "name": "List Products",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/products" }
        },
        {
          "name": "Get Product by ID",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/products/1" }
        },
        {
          "name": "Product Categories",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/products/categories" }
        },
        {
          "name": "List Categories",
          "request": { "auth": { "type": "noauth" }, "method": "GET", "url": "{{baseUrl}}/api/categories" }
        }
      ]
    },
    {
      "name": "Cart",
      "item": [
        {
          "name": "Get Cart",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/cart" }
        },
        {
          "name": "Add to Cart",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"product_id\": 1,\n  \"quantity\": 1\n}" },
            "url": "{{baseUrl}}/api/cart"
          }
        },
        {
          "name": "Update Cart Item (use item_id from Get Cart)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2\n}" },
            "url": "{{baseUrl}}/api/cart/1"
          }
        },
        {
          "name": "Remove Cart Item (use item_id from Get Cart)",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/cart/1" }
        }
      ]
    },
    {
      "name": "Orders",
      "item": [
        {
          "name": "Place Order",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Shifa Siddiqui\",\n  \"phone\": \"9876543210\",\n  \"address\": \"Test Address, Nagpur\",\n  \"city\": \"Nagpur\",\n  \"pincode\": \"440001\"\n}" },
            "url": "{{baseUrl}}/api/orders"
          }
        },
        {
          "name": "My Orders",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders" }
        },
        {
          "name": "Order Detail",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/orders/1" }
        },
        {
          "name": "Cancel Order",
          "request": { "method": "PUT", "url": "{{baseUrl}}/api/orders/1/cancel" }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Stats",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/stats" }
        },
        {
          "name": "Admin List Products",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/products" }
        },
        {
          "name": "Admin Create Product",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Postman Product\",\n  \"description\": \"Created from Postman\",\n  \"price\": 499,\n  \"stock\": 10,\n  \"category_id\": 1\n}" },
            "url": "{{baseUrl}}/api/admin/products"
          }
        },
        {
          "name": "Admin Update Product",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 549,\n  \"stock\": 20\n}" },
            "url": "{{baseUrl}}/api/admin/products/1"
          }
        },
        {
          "name": "Admin Delete Product",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/admin/products/1" }
        },
        {
          "name": "Admin List Categories",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/categories" }
        },
        {
          "name": "Admin Create Category",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"New Category\"\n}" },
            "url": "{{baseUrl}}/api/admin/categories"
          }
        },
        {
          "name": "Admin Update Category",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Renamed Category\"\n}" },
            "url": "{{baseUrl}}/api/admin/categories/1"
          }
        },
        {
          "name": "Admin Delete Category",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/api/admin/categories/1" }
        },
        {
          "name": "Admin List Orders",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/admin/orders" }
        },
        {
          "name": "Admin Update Order Status",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"Shipped\"\n}" },
            "url": "{{baseUrl}}/api/admin/orders/1/status"
          }
        }
      ]
    }
  ]
}